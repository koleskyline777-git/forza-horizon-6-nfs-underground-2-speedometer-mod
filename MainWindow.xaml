<Window x:Class="Nfsu2ForzaHud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NFSU2 Forza HUD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Loaded="OnLoaded"
        Closing="OnClosing"
        StateChanged="OnStateChanged"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseWheel="OnMouseWheel">
    <Grid>
        <!--
          NFSU2HUD 3.0 layout at logical 800², scaled via Viewbox to Forza-sized bottom-right.
        -->
        <Viewbox x:Name="HudViewbox" Stretch="Fill" Width="800" Height="800">
            <Canvas x:Name="RaceCluster" Width="800" Height="800" Opacity="0.97" ClipToBounds="False">
                <Image x:Name="ImgBoostNos" Width="800" Height="800" Stretch="Fill"
                       Canvas.Left="0" Canvas.Top="0" />

                <Image x:Name="ImgBackground" Width="400" Height="400" Stretch="Fill"
                       Canvas.Left="200" Canvas.Top="200" />
                <Image x:Name="ImgRpmFace" Width="400" Height="400" Stretch="Fill"
                       Canvas.Left="200" Canvas.Top="200" />
                <Image x:Name="ImgRev" Width="400" Height="400" Stretch="Fill"
                       Canvas.Left="200" Canvas.Top="200" />
                <Image x:Name="ImgSpeed" Width="400" Height="400" Stretch="Fill"
                       Canvas.Left="200" Canvas.Top="200" />
                <Image x:Name="ImgGearFlash" Width="400" Height="400" Stretch="Fill"
                       Canvas.Left="200" Canvas.Top="200" />

                <Image x:Name="ImgBoostNeedle" Width="160" Height="160" Stretch="Fill"
                       Canvas.Left="42.4" Canvas.Top="398.1" />
                <Image x:Name="ImgGear" Width="38" Height="38" Stretch="Fill"
                       Canvas.Left="515.6" Canvas.Top="356" />
                <Image x:Name="ImgUom" Width="90" Height="24" Stretch="Fill"
                       Canvas.Left="451" Canvas.Top="481.5" />
            </Canvas>
        </Viewbox>

        <Border x:Name="StatusBar" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="8" Padding="8,5" Background="#99000000" CornerRadius="6"
                IsHitTestVisible="False" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="TxtStatus" Foreground="#CFE8FF" FontSize="11"
                           Text="NFSU2 HUD — waiting for FH6 Data Out…" />
                <TextBlock x:Name="TxtHotkeys" Foreground="#88AACC" FontSize="10"
                           Text="F1 HUD  ·  F2 mph/kph  ·  F3 demo  ·  F4 move  ·  F5 status  ·  F9 quit" />
            </StackPanel>
        </Border>

        <!-- Shown when NFSU2HUD art is missing (common on a fresh PC / Release zip). -->
        <Border x:Name="MissingAssetsPanel" Visibility="Collapsed"
                Background="#E6101828" Padding="28" Margin="40"
                CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                MaxWidth="520">
            <StackPanel>
                <TextBlock Text="HUD art not found"
                           Foreground="#FF8A3D" FontSize="22" FontWeight="Bold" Margin="0,0,0,10" />
                <TextBlock TextWrapping="Wrap" Foreground="#E8EEF7" FontSize="13" LineHeight="20"
                           Text="This Release does not include NFSU2HUD textures (copyright). Copy the Assetto Corsa NFSU2HUD 3.0 img folder to Assets\AcHud next to the .exe — see ASSETS.md." />
                <TextBlock x:Name="TxtMissingPath" TextWrapping="Wrap" Foreground="#88AACC" FontSize="11"
                           Margin="0,12,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button x:Name="BtnPickAssets" Content="Choose img folder…" Padding="14,8" Margin="0,0,10,0"
                            Click="OnPickAssetsClick" />
                    <Button x:Name="BtnOpenAssetsDoc" Content="Open ASSETS.md" Padding="14,8"
                            Click="OnOpenAssetsDocClick" />
                </StackPanel>
                <TextBlock Text="F4 = move this window · F9 = quit" Foreground="#6688AA" FontSize="11" Margin="0,14,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
